---
/**
 * One line of a made-up making-of exchange, as a chat bubble: the author ("me", right,
 * in the accent colour) or the agent (left, on a dark surface).
 */
interface Props {
  who: "me" | "agent";
}
const { who } = Astro.props;
---

<div class:list={["mo-line", who]}>
  <span class="who">{who === "me" ? "Me" : "Agent"}</span>
  <p class="bubble"><slot /></p>
</div>

<style>
  .mo-line {
    display: grid;
    gap: 4px;
    max-width: 84%;
  }
  .who {
    font: 500 10px var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .bubble {
    margin: 0;
    padding: 11px 15px;
    border-radius: 18px;
    font-size: 16px;
    line-height: 1.42;
  }
  .agent {
    justify-self: start;
  }
  .agent .bubble {
    border: 1px solid var(--color-line);
    background: #14100c;
    border-bottom-left-radius: 6px;
    color: var(--color-cream);
  }
  .me {
    justify-self: end;
  }
  .me .who {
    justify-self: end;
    color: var(--color-accent);
  }
  .me .bubble {
    background: var(--color-accent);
    color: #160800;
    font-weight: 600;
    border-bottom-right-radius: 6px;
    box-shadow: 0 0 26px color-mix(in oklab, var(--color-accent) 28%, transparent);
  }
</style>
