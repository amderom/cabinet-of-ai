---
/**
 * TEMPORARY (2026-11-11): lets the author compare three desktop layouts of the making-of on
 * the preview. Remove this file and its use in making-of.mdx once she has picked one, and
 * keep only that layout's rules in global.css. Shown from 1024px only (phones have one layout).
 */
const options = [
  ["a", "A · Column"],
  ["b", "B · Side by side"],
  ["c", "C · Margin notes"],
];
---

<div class="mo-switch" role="group" aria-label="Layout to compare (temporary)">
  {
    options.map(([key, name]) => (
      <button type="button" data-mo-pick={key} aria-pressed="false">
        {name}
      </button>
    ))
  }
</div>

<style>
  .mo-switch {
    display: none;
  }
  @media (min-width: 1024px) {
    .mo-switch {
      position: fixed;
      z-index: 50;
      left: 50%;
      bottom: 20px;
      translate: -50% 0;
      display: flex;
      gap: 4px;
      padding: 4px;
      border: 1px solid var(--color-line);
      border-radius: 999px;
      background: rgb(10 8 6 / 0.9);
      backdrop-filter: blur(8px);
    }
  }
  button {
    min-height: 40px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    font: 600 13px var(--font-sans);
    cursor: pointer;
  }
  button[aria-pressed="true"] {
    background: var(--color-accent);
    color: #160800;
  }
  button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<script>
  function apply(key: string) {
    const article = document.querySelector<HTMLElement>(".prose-cabinet");
    if (article) article.dataset.mo = key;
    document.querySelectorAll<HTMLButtonElement>("[data-mo-pick]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.moPick === key)));
    try {
      localStorage.setItem("making-of-layout", key);
    } catch {}
  }
  document.addEventListener("astro:page-load", () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-mo-pick]");
    if (!buttons.length) return;
    let saved = "a";
    try {
      saved = localStorage.getItem("making-of-layout") ?? "a";
    } catch {}
    buttons.forEach((b) => b.addEventListener("click", () => apply(b.dataset.moPick ?? "a")));
    apply(saved);
  });
</script>
