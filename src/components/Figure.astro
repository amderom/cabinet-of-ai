---
/**
 * An exhibit image placed by its credit id: <Figure id="the-engine" />.
 * Alt text, caption and credit come from the exhibit's `credits`, so nothing
 * is typed twice. The exhibit is the one of the current page ([slug]).
 * If the credit has a `phoneFile`, small screens get that version.
 */
import { getEntry } from "astro:content";
import { getImage, Image } from "astro:assets";
import { creditFor } from "../lib/credits";

interface Props {
  id: string;
}

const { id } = Astro.props;
const slug = Astro.params.slug;
const exhibit = slug ? await getEntry("exhibits", slug) : undefined;
if (!exhibit) throw new Error(`<Figure id="${id}"> is used outside an exhibit page`);

const credit = creditFor(exhibit.data.credits, id, exhibit.id);
if (!credit.file) throw new Error(`Exhibit "${exhibit.id}": credit "${id}" has no image file`);

// Shown at most at the reading column's width (62ch ≈ 680px), up to 2× for sharp screens.
const widths = [360, 540, 720, 1080, 1360];
const sizes = "(min-width: 768px) 680px, calc(100vw - 32px)";
const phone = credit.phoneFile ? await getImage({ src: credit.phoneFile, widths, sizes }) : undefined;
const creditLine = [credit.author, credit.source].filter(Boolean).join(" · ");
---

<figure class="figure">
  <div class="figure-plate">
    <picture>
      {phone && <source media="(max-width: 639px)" srcset={phone.srcSet.attribute} sizes={sizes} />}
      <Image src={credit.file} alt={credit.alt ?? ""} widths={widths} sizes={sizes} />
    </picture>
  </div>
  <figcaption>
    {credit.caption && <span class="block">{credit.caption}</span>}
    <span class="label mt-1.5 block text-muted">{creditLine}</span>
  </figcaption>
</figure>
