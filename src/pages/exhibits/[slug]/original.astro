---
/**
 * The original text an exhibit rebuilds (optional: only exhibits with an original.mdx).
 * Read in the same layout as the essay; the source note comes from the text's credit,
 * so the edition is typed once, in exhibit.yaml.
 */
import { render, type CollectionEntry } from "astro:content";
import ExhibitLayout from "../../../layouts/ExhibitLayout.astro";
import { creditFor } from "../../../lib/credits";
import { originalPaths } from "../../../lib/exhibit-pages";

export const getStaticPaths = () => originalPaths();

interface Props {
  exhibit: CollectionEntry<"exhibits">;
  entry: CollectionEntry<"originals">;
}

const { exhibit, entry } = Astro.props;
const { Content } = await render(entry);
const ids = Array.isArray(entry.data.credit) ? entry.data.credit : [entry.data.credit];
const sources = ids.map((id) => creditFor(exhibit.data.credits, id, exhibit.id));
---

<ExhibitLayout exhibit={exhibit} part="original" title={entry.data.title} description={entry.data.description}>
  <article class="prose-cabinet">
    <h2>{entry.data.title}</h2>
    <div class="label mb-8 text-muted">{entry.data.lead}</div>
    <Content />
    <div class="mt-[var(--space-object)] border-t border-line pt-4">
      {
        sources.map((source) => (
          <p class="label leading-relaxed text-muted">
            Source: {source.asset} · {source.author} ·{" "}
            {source.url ? <a href={source.url}>{source.source}</a> : source.source} · {source.licence}
          </p>
        ))
      }
    </div>
  </article>
</ExhibitLayout>
