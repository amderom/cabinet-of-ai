---
import { render, type CollectionEntry } from "astro:content";
import ExhibitLayout from "../../../layouts/ExhibitLayout.astro";
import { partPaths } from "../../../lib/exhibit-pages";

export const getStaticPaths = () => partPaths("essay");

interface Props {
  exhibit: CollectionEntry<"exhibits">;
  entry: CollectionEntry<"essays">;
}

const { exhibit, entry } = Astro.props;
const { Content } = await render(entry);
---

<ExhibitLayout exhibit={exhibit} part="essay">
  <article class="prose-cabinet">
    <h2>{entry.data.title}</h2>
    <Content />
  </article>
</ExhibitLayout>
