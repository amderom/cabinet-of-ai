---
/**
 * The site's one sound control: a small "Sound" toggle placed where the play is (right of a
 * demo's play heading, the same spot in every exhibit). Reading pages never make a sound,
 * so they have none. Silence is the default; the choice is remembered across the site.
 * Pressed = sound on. The tap also counts as the gesture iPhones need before a page may
 * play sound, and turning sound on is what downloads Howler.
 */
---

<button type="button" class="sound-toggle label" data-sound-toggle aria-pressed="false">
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
    <path class="speaker" d="M3 9.5v5h4l5 4v-13l-5 4H3z"></path>
    <path class="waves" d="M15.5 9a4 4 0 0 1 0 6M18.5 6.5a7.5 7.5 0 0 1 0 11"></path>
    <path class="cross" d="M16 9.5l5 5M21 9.5l-5 5"></path>
  </svg>
  Sound
</button>

<script>
  import { getPreference, onPreferenceChange, setPreference } from "./player";
  import { toggled } from "./preference";

  function sync() {
    for (const button of document.querySelectorAll("[data-sound-toggle]")) {
      button.setAttribute("aria-pressed", String(getPreference() === "on"));
    }
  }

  // Runs on the first load and after every page change, binding the new page's toggle.
  document.addEventListener("astro:page-load", () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-sound-toggle]")) {
      if (button.dataset.bound) continue;
      button.dataset.bound = "true";
      button.addEventListener("click", () => setPreference(toggled(getPreference())));
    }
    sync();
  });
  onPreferenceChange(sync);
</script>

<style>
  .sound-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 0.2s;
  }
  .sound-toggle:hover,
  .sound-toggle[aria-pressed="true"] {
    color: var(--color-cream);
  }
  .sound-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .speaker {
    fill: currentColor;
    stroke: none;
  }
  .waves {
    display: none;
    stroke: var(--color-accent);
  }
  [aria-pressed="true"] .waves {
    display: inline;
  }
  [aria-pressed="true"] .cross {
    display: none;
  }
</style>
