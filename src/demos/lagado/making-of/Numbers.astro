---
/**
 * The making-of's numbers: one big figure at a time over the machine's own backdrop (its
 * field of short lines, drawn as in Machine.tsx) and the site's accent glow. Each new figure
 * scrambles into place like the machine's words, sends an accent ring through the field
 * and moves the glow. Tap (or Enter / arrows) for the next one; auto-advances otherwise.
 * Nothing moves with reduced motion. Figures from docs/features/lagado/journal.md.
 */
const STATS = [
  ["2", "days to build the machine", "10–11 November 2026"],
  ["28", "prototypes before it felt right", "versions of the clickable prototype"],
  ["15", "card styles. One survived.", "the three plates above the machine"],
  ["4", "word animations. The first one won.", "a scramble, a die, a flip card, a flip"],
  ["190", "words in the machine", "11 of them in Swift’s spelling"],
  ["13", "sounds auditioned. Three kept.", "chosen by ear; the agent can’t hear"],
  ["89", "automatic tests", "and every change checked on three screen sizes"],
];
const [first] = STATS;
---

<section
  class="mo-numbers"
  data-stats={JSON.stringify(STATS)}
  tabindex="0"
  aria-label="The build in numbers. Tap for the next number.">
  <div class="glow" aria-hidden="true"></div>
  <canvas class="field" aria-hidden="true"></canvas>
  <div class="grain" aria-hidden="true"></div>
  <span class="label hint" aria-hidden="true">Tap</span>
  <div class="stat" aria-live="polite">
    <span class="label note">{first[2]}</span>
    <span class="big">{first[0]}</span>
    <p class="say">{first[1]}</p>
  </div>
  <div class="dots" aria-hidden="true">{STATS.map((_, i) => <span class:list={{ on: i === 0 }} />)}</div>
</section>

<style>
  .mo-numbers {
    position: relative;
    height: min(78svh, 560px);
    min-height: 420px;
    margin-block: 2.6em;
    border: 1px solid var(--color-line);
    border-radius: 22px;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-ink, #0a0806);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .mo-numbers:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .glow {
    position: absolute;
    z-index: -3;
    left: -30%;
    top: -25%;
    width: 160%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      var(--color-accent) 0%,
      color-mix(in oklab, var(--color-accent) 55%, #3a0d00) 32%,
      transparent 64%
    );
    filter: blur(48px);
    opacity: 0.42;
    animation: mo-glow 14s ease-in-out infinite alternate;
    transition:
      left 1.8s cubic-bezier(0.3, 0.7, 0.2, 1),
      top 1.8s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .field {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .grain {
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: 0.18;
    mix-blend-mode: overlay;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
  .hint {
    position: absolute;
    top: 16px;
    right: 18px;
  }
  .stat {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 10px;
    padding: 24px;
    text-align: center;
  }
  .note {
    color: var(--color-muted);
  }
  .big {
    font: 400 clamp(110px, 38vw, 200px) / 0.85 var(--font-display);
    color: var(--color-accent);
    text-shadow: 0 0 40px color-mix(in oklab, var(--color-accent) 45%, transparent);
    font-variant-numeric: tabular-nums;
  }
  .say {
    max-width: 13ch;
    margin: 0 auto;
    font: 700 clamp(26px, 7.4vw, 40px) / 1.05 var(--font-sans);
    letter-spacing: -0.02em;
    color: var(--color-cream);
  }
  .dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    display: flex;
    justify-content: center;
    gap: 6px;
  }
  .dots span {
    width: 18px;
    height: 3px;
    border-radius: 2px;
    background: rgb(244 236 223 / 0.25);
    transition:
      background 0.3s,
      width 0.3s;
  }
  .dots span.on {
    width: 30px;
    background: var(--color-accent);
  }
  @keyframes mo-glow {
    to {
      transform: translate(8%, 14%) scale(1.12);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .glow {
      animation: none;
      transition: none;
    }
    .dots span {
      transition: none;
    }
  }
</style>

<script>
  const reduce = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
  const SPOTS = [
    [-30, -25],
    [-55, -10],
    [-10, -40],
    [-45, 5],
    [-20, -5],
    [-60, -35],
    [-35, -45],
  ];

  function setUp(box: HTMLElement) {
    const stats: [string, string, string][] = JSON.parse(box.dataset.stats ?? "[]");
    const canvas = box.querySelector("canvas")!;
    const ctx = canvas.getContext("2d");
    const glow = box.querySelector<HTMLElement>(".glow")!;
    const big = box.querySelector<HTMLElement>(".big")!;
    const say = box.querySelector<HTMLElement>(".say")!;
    const note = box.querySelector<HTMLElement>(".note")!;
    const dots = [...box.querySelectorAll<HTMLElement>(".dots span")];
    const still = reduce();
    const accent = getComputedStyle(box).getPropertyValue("--color-accent").trim() || "#ff5f1f";
    let at = 0;
    let timer = 0;
    let burstAt = -Infinity;
    let frame = 0;
    let last = -Infinity;
    let visible = true;

    // The machine's field: 1 × 10 px strokes every 14 × 22 px, brighter where a slow ripple
    // passes, faded at the top and bottom; plus an accent ring after each new figure.
    const paint = (t: number) => {
      if (!ctx) return;
      const dpr = devicePixelRatio || 1;
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (canvas.width !== Math.round(w * dpr) || canvas.height !== Math.round(h * dpr)) {
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      const age = t - burstAt;
      const radius = age * 0.42;
      const fade = Math.max(0, 1 - age / 1800);
      for (let x = 7; x < w; x += 14) {
        for (let y = 6; y < h; y += 22) {
          const edge = Math.min(1, y / 48, (h - y - 10) / 64);
          if (edge <= 0) continue;
          const d = Math.hypot(x - w / 2, (y - h / 2) * 1.4);
          const ripple = still ? 0.3 : Math.max(0, Math.sin(d / 38 - t / 900));
          const ring = still || fade <= 0 ? 0 : Math.exp(-((d - radius) ** 2) / 1800) * fade;
          ctx.fillStyle = ring > 0.25 ? accent : "rgb(244 236 223)";
          ctx.globalAlpha = Math.min(1, (0.05 + 0.13 * ripple + 0.7 * ring) * edge);
          ctx.fillRect(x, y, 1, 10 + 6 * ring);
        }
      }
      ctx.globalAlpha = 1;
    };
    const loop = (t: number) => {
      frame = 0;
      if (!visible || document.hidden || !box.isConnected) return;
      if (t - last >= 33) {
        last = t;
        paint(t);
      }
      if (!still) frame = requestAnimationFrame(loop);
    };
    const start = () => {
      if (!frame) frame = requestAnimationFrame(loop);
    };

    // The figure scrambles into place, one more real digit every 70 ms.
    const scramble = (text: string) => {
      if (still) return void (big.textContent = text);
      const t0 = performance.now();
      const step = (now: number) => {
        const shown = Math.floor((now - t0) / 70);
        big.textContent = [...text].map((ch, i) => (i < shown ? ch : "0123456789#%&*"[Math.floor(Math.random() * 14)])).join("");
        if (shown < text.length) requestAnimationFrame(step);
        else big.textContent = text;
      };
      requestAnimationFrame(step);
    };

    const show = (i: number, animate = true) => {
      at = (i + stats.length) % stats.length;
      const [n, line, small] = stats[at];
      if (animate) scramble(n);
      say.textContent = line;
      note.textContent = small;
      dots.forEach((d, k) => d.classList.toggle("on", k === at));
      if (!still) {
        burstAt = performance.now();
        glow.style.left = `${SPOTS[at % SPOTS.length][0]}%`;
        glow.style.top = `${SPOTS[at % SPOTS.length][1]}%`;
        clearTimeout(timer);
        timer = window.setTimeout(() => box.isConnected && show(at + 1), 4200);
      }
      last = -Infinity;
      start();
    };

    box.addEventListener("click", () => show(at + 1));
    box.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " " || e.key === "ArrowRight") {
        e.preventDefault();
        show(at + 1);
      } else if (e.key === "ArrowLeft") show(at - 1);
    });
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) start();
    }).observe(canvas);
    new ResizeObserver(() => {
      last = -Infinity;
      start();
    }).observe(canvas);
    document.addEventListener("visibilitychange", start);
    show(0, false);
  }

  // Runs on first load and after every page change (view transitions).
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>(".mo-numbers").forEach((box) => {
      if (box.dataset.ready) return;
      box.dataset.ready = "true";
      setUp(box);
    });
  });
</script>
