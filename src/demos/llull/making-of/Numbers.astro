---
/**
 * The making-of's numbers (same piece as Lagado's, with Llull's figures): one big figure at a
 * time, a soft accent glow behind it; tap (or Enter / arrows) for the next one; it also moves on
 * by itself. Nothing moves with reduced motion. Figures from docs/features/llull/journal.md.
 */
const STATS = [
  ["1", "day, from spec to the last page", "13 November 2026"],
  ["7", "prototypes before it felt right", "Lagado needed 28"],
  ["9", "questions for the Art", "6 of Llull’s, 3 from 2026"],
  ["23", "quotations checked word for word", "against Dambergs’ translation, by script"],
  ["4", "old books read by the agent", "1517, 1617, 1906, 1929"],
  ["0", "pixels changed on Lagado", "when the two exhibits started sharing their plates"],
  ["128", "automatic tests", "and every change checked on four screen sizes"],
];
const [first] = STATS;
---

<section
  class="mo-numbers"
  data-stats={JSON.stringify(STATS)}
  tabindex="0"
  aria-label="The build in numbers. Tap for the next number.">
  <div class="halo" aria-hidden="true"></div>
  <div class="stat" aria-live="polite">
    <span class="label note">{first[2]}</span>
    <span class="big">{first[0]}</span>
    <p class="say">{first[1]}</p>
  </div>
  <div class="foot" aria-hidden="true">
    <span class="dots">{STATS.map((_, i) => <span class:list={{ on: i === 0 }} />)}</span>
    <span class="label">Tap for the next</span>
  </div>
</section>

<style>
  .mo-numbers {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: center;
    gap: 22px;
    min-height: 380px;
    margin-block: var(--space-object);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .mo-numbers:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 8px;
    border-radius: 12px;
  }
  /* The glow: a soft accent light behind the figure, breathing slowly; it flares on a new figure. */
  .halo {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 42%;
    width: min(88%, 420px);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--color-accent) 70%, transparent) 0%,
      color-mix(in oklab, var(--color-accent) 22%, transparent) 38%,
      transparent 68%
    );
    filter: blur(36px);
    opacity: 0.32;
    animation: mo-breathe 6s ease-in-out infinite alternate;
    transition: opacity 0.9s ease;
  }
  .mo-numbers.flare .halo {
    opacity: 0.6;
    transition-duration: 0.15s;
  }
  .stat {
    display: grid;
    justify-items: center;
    gap: 10px;
    text-align: center;
  }
  .note {
    color: var(--color-muted);
  }
  .big {
    font: 400 clamp(110px, 34vw, 184px) / 0.85 var(--font-display);
    color: var(--color-accent);
    text-shadow:
      0 0 24px color-mix(in oklab, var(--color-accent) 55%, transparent),
      0 0 64px color-mix(in oklab, var(--color-accent) 30%, transparent);
    font-variant-numeric: tabular-nums;
  }
  .say {
    max-width: 14ch;
    margin: 0;
    font: 700 clamp(26px, 7vw, 34px) / 1.05 var(--font-sans);
    letter-spacing: -0.02em;
    color: var(--color-cream);
  }
  .foot {
    display: grid;
    justify-items: center;
    gap: 10px;
  }
  .foot .label {
    color: var(--color-muted);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots span {
    width: 18px;
    height: 3px;
    border-radius: 2px;
    background: rgb(244 236 223 / 0.22);
    transition:
      background 0.3s,
      width 0.3s;
  }
  .dots span.on {
    width: 30px;
    background: var(--color-accent);
    box-shadow: 0 0 10px color-mix(in oklab, var(--color-accent) 60%, transparent);
  }
  @keyframes mo-breathe {
    from {
      scale: 0.92;
    }
    to {
      scale: 1.04;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .halo {
      animation: none;
      transition: none;
    }
    .dots span {
      transition: none;
    }
  }
</style>

<script>
  const reduce = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  function setUp(box: HTMLElement) {
    const stats: [string, string, string][] = JSON.parse(box.dataset.stats ?? "[]");
    const big = box.querySelector<HTMLElement>(".big")!;
    const say = box.querySelector<HTMLElement>(".say")!;
    const note = box.querySelector<HTMLElement>(".note")!;
    const dots = [...box.querySelectorAll<HTMLElement>(".dots span")];
    const still = reduce();
    let at = 0;
    let timer = 0;
    let flareTimer = 0;

    // The figure scrambles into place, one more real digit every 70 ms.
    const scramble = (text: string) => {
      if (still) return void (big.textContent = text);
      const t0 = performance.now();
      const step = (now: number) => {
        const shown = Math.floor((now - t0) / 70);
        big.textContent = [...text].map((ch, i) => (i < shown ? ch : "0123456789#%&*"[Math.floor(Math.random() * 14)])).join("");
        if (shown < text.length) requestAnimationFrame(step);
        else big.textContent = text;
      };
      requestAnimationFrame(step);
    };

    const show = (i: number) => {
      at = (i + stats.length) % stats.length;
      const [n, line, small] = stats[at];
      scramble(n);
      say.textContent = line;
      note.textContent = small;
      dots.forEach((d, k) => d.classList.toggle("on", k === at));
      if (still) return;
      box.classList.add("flare");
      clearTimeout(flareTimer);
      flareTimer = window.setTimeout(() => box.classList.remove("flare"), 220);
      clearTimeout(timer);
      timer = window.setTimeout(() => box.isConnected && show(at + 1), 4200);
    };

    box.addEventListener("click", () => show(at + 1));
    box.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " " || e.key === "ArrowRight") {
        e.preventDefault();
        show(at + 1);
      } else if (e.key === "ArrowLeft") show(at - 1);
    });
    if (!still) timer = window.setTimeout(() => box.isConnected && show(1), 4200);
  }

  // Runs on first load and after every page change (view transitions).
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>(".mo-numbers").forEach((box) => {
      if (box.dataset.ready) return;
      box.dataset.ready = "true";
      setUp(box);
    });
  });
</script>
