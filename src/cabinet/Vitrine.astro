---
/**
 * The home page's vitrine: one tall card per exhibit, floating, read from the content
 * collection. Each card is the "master" of the plates inside its exhibit (same cream paper,
 * black ink, mono labels): its engraving, its title and its tagline as subtitle.
 * One tap on an open card goes to the exhibit; its engraving grows into the exhibit page's
 * background engraving (shared view-transition name), and its title into the page title.
 * Chosen and refined with the author on 2026-11-13. See SPEC.md.
 */
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { creditFor } from "../lib/credits";
import { slotsFor, specimensFrom } from "./specimens";
import "./vitrine.css";

const exhibits = await getCollection("exhibits");
const cards = specimensFrom(exhibits);
const { slots, caseHeight } = slotsFor(cards.length);

// An open card shows its exhibit's engraving: the one its pages use as background texture.
const art = new Map<string, { src: string; alt: string }>();
for (const exhibit of exhibits) {
  const id = exhibit.data.texture;
  if (!id || exhibit.data.status !== "open") continue;
  const credit = creditFor(exhibit.data.credits, id, exhibit.id);
  if (credit.file) {
    const image = await getImage({ src: credit.file, format: "webp", width: 480, quality: 70 });
    art.set(exhibit.id, { src: image.src, alt: credit.alt ?? "" });
  }
}
---

<div class="vitrine" data-vitrine style={`--case-h: ${caseHeight}`}>
  {
    cards.map((c, i) => {
      const slot = slots[i];
      const style = `--c: ${c.rgb}; --left: ${slot.left}; --top: ${slot.top}; --tilt: ${slot.tilt}deg; --i: ${i}`;
      const picture = art.get(c.slug);
      const inner = (
        <>
          <span class="vt-top label">
            <span>Exhibit</span>
            <span>{c.year}</span>
          </span>
          <span class="vt-pic">
            {picture ? (
              <img src={picture.src} alt="" decoding="async" style={`view-transition-name: exhibit-art-${c.slug}; view-transition-class: exhibit-art`} />
            ) : (
              <span class="vt-stamp label">Sealed</span>
            )}
          </span>
          <span class="vt-cap">
            <span class="vt-t" transition:name={`exhibit-title-${c.slug}`}>{c.title}</span>
            {!c.sealed && <span class="vt-sub">{c.tagline}</span>}
            <span class="vt-status label" data-status>{c.sealed ? "Sealed" : "Enter →"}</span>
          </span>
        </>
      );
      return c.href ? (
        <a class="vt-card" href={c.href} style={style} data-accent={c.accent}>
          {inner}
        </a>
      ) : (
        <div class="vt-card vt-sealed" style={style} data-accent={c.accent} role="group" aria-label={`${c.title}: sealed, opening later in the series`}>
          {inner}
        </div>
      );
    })
  }
</div>

<script>
  import { initVitrine } from "./vitrine";
  // Re-run after each page change (the site changes pages without full reloads).
  document.addEventListener("astro:page-load", initVitrine);
</script>
