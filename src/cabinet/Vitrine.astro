---
/**
 * The home page's vitrine: the exhibits float as plates in a glass case marked only by four
 * corner marks. Each plate carries its own exhibit's engraving and colour; sealed plates show
 * a static pattern. Plain links first (works without JavaScript); vitrine.ts adds choosing.
 * Chosen with the author on 2026-11-13 ("A · Specimens", prototype round 2). See SPEC.md.
 */
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { creditFor } from "../lib/credits";
import { slotsFor, specimensFrom } from "./specimens";
import "./vitrine.css";

const exhibits = await getCollection("exhibits");
const specimens = specimensFrom(exhibits);
const { slots, caseHeight } = slotsFor(specimens.length);

// Each open plate shows its exhibit's engraving (the one used as its page texture), small and light.
const art = new Map<string, string>();
for (const exhibit of exhibits) {
  const id = exhibit.data.texture;
  if (!id || exhibit.data.status !== "open") continue;
  const file = creditFor(exhibit.data.credits, id, exhibit.id).file;
  if (file) art.set(exhibit.id, (await getImage({ src: file, format: "avif", width: 360, quality: 50 })).src);
}
---

<div class="vitrine" data-vitrine style={`--case-h: ${caseHeight}px`}>
  <span class="vt-corner vt-c1" aria-hidden="true"></span>
  <span class="vt-corner vt-c2" aria-hidden="true"></span>
  <span class="vt-corner vt-c3" aria-hidden="true"></span>
  <span class="vt-corner vt-c4" aria-hidden="true"></span>
  {
    specimens.map((s, i) => {
      const slot = slots[i];
      const style = `--c: ${s.rgb}; --left: ${slot.left}%; --top: ${slot.top}px; --tilt: ${slot.tilt}deg; --i: ${i}`;
      const inner = (
        <>
          {art.has(s.slug) ? (
            <span class="vt-art" aria-hidden="true">
              <img src={art.get(s.slug)} alt="" decoding="async" />
              <span class="vt-tint" />
            </span>
          ) : (
            <span class="vt-art vt-static" aria-hidden="true" />
          )}
          {s.sealed && <span class="vt-tag label">Sealed</span>}
          <span class="vt-cap">
            <span class="vt-k label">{s.label}</span>
            <span class="vt-t" transition:name={`exhibit-title-${s.slug}`}>{s.title}</span>
          </span>
        </>
      );
      return s.href ? (
        <a class="vt-plate" href={s.href} style={style} data-accent={s.accent} data-year={s.year ?? ""}>
          {inner}
        </a>
      ) : (
        <div class="vt-plate vt-sealed" style={style} data-accent={s.accent} data-year={s.year ?? ""} aria-label={`${s.title}, sealed`}>
          {inner}
        </div>
      );
    })
  }
  <div class="vt-detail" data-detail aria-live="polite"></div>
</div>

<script>
  import { initVitrine } from "./vitrine";
  // Re-run after each page change (the site changes pages without full reloads).
  document.addEventListener("astro:page-load", initVitrine);
</script>
